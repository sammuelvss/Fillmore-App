# URL base da API Express 5 + PostgreSQL (NeonDB) publicada na Vercel (Etapa 1)
# Importante: Não adicione barra (/) no final da URL.
# Ao testar no celular físico via Expo Go, apontar para a Vercel evita bloqueios de firewall/IP local!
EXPO_PUBLIC_API_URL=https://sua-api-na-vercel.vercel.app

# Defina como true para exibir o painel "Modo Dev / Quick Token" na tela de login
# (uso apenas em desenvolvimento, para contornar o rate limit de 5 logins/15 min da API).
EXPO_PUBLIC_SHOW_DEV=false
