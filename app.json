{
  "expo": {
    "name": "Fillmore Transporte Escolar",
    "slug": "fillmore-mobile",
    "owner": "sammuelvictors-team",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fillmore",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1E293B",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unicap.fillmore"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F59E0B"
      },
      "package": "com.unicap.fillmore"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "be5a0b6f-0da6-4cf9-a005-72a44672811b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/be5a0b6f-0da6-4cf9-a005-72a44672811b"
    }
  }
}
